@startuml FinalClassModel
skinparam classAttributeIconSize 0
skinparam backgroundColor #FFFFFF
skinparam style strictuml
skinparam Shadowing false
skinparam DefaultFontName 'Segoe UI', Arial, sans-serif
skinparam DefaultFontSize 11

skinparam class {
    BackgroundColor #FFFFFF
    HeaderBackgroundColor #D1E7DD
    BorderColor #000000
    FontColor #000000
}

class "OrderProcessor" as OrderProcessor <<controller>> {
    - store: DataStore
    - listeners: List
    + registerCustomer(...)
    + submitOrder(...)
    + approveOrder(id)
}

class "DispatchManager" as DispatchManager <<controller>> {
    - store: DataStore
    + assignShipment(...)
    + onOrderApproved(...)
}

class "ShipmentTracker" as ShipmentTracker <<controller>> {
    - store: DataStore
    - telemetry: ITelemetrySource
    + recordMilestone(...)
    + recordDelivery(...)
}

class "PaymentProcessor" as PaymentProcessor <<controller>> {
    - store: DataStore
    - gateway: IPaymentGateway
    + submitPayment(...)
}

class "DataStore" as DataStore <<infrastructure>> {
    - conn: Connection
    - version: int = 3
    + load()
    + save()
    + customers()
    + orders()
}

class "Customer" as Customer {
    - id: String
    - fullName: String
    - phone: String
    + recordOrder(id)
}

class "Order" as Order {
    - id: String
    - state: OrderState
    - quotedAmount: double
    + approve()
    + cancel()
    + addConsignment(...)
}

class "ServiceOffering" as ServiceOffering {
    - id: String
    - name: String
    - tariffId: String
    + isAvailableAt(branchId)
}

class "Branch" as Branch {
    - id: String
    - name: String
    - city: String
    + addVehicle(...)
    + addDriver(...)
}

class "Invoice" as Invoice {
    - id: String
    - amount: double
    - state: InvoiceState
    + recordPayment(...)
    + isSettled()
}

class "Consignment" as Consignment {
    - id: String
    - weightKg: double
    - desc: String
    + getWeightKg()
}

class "Shipment" as Shipment {
    - id: String
    - state: ShipmentState
    - location: String
    + pickup()
    + deliver()
    + updateLocation(...)
}

class "Vehicle" as Vehicle {
    - id: String
    - capacityKg: double
    - status: String
    + assignToShipment()
}

class "Driver" as Driver {
    - licenseNo: String
    - dutyState: DutyState
    + setDutyState(...)
}

class "Payment" as Payment {
    - id: String
    - amount: double
    - state: PaymentState
    + settle()
}

class "Person / StaffMember" as Person <<abstract>> {
    - id: String
    - fullName: String
    - role: StaffRole
    + getRole()
}

class "Receipt" as Receipt {
    - id: String
    - paymentId: String
    - issuedAt: DateTime
    + getFormattedReceipt()
}

class "OrderState / ShipmentState" as State <<abstract>> {
    - stateName: String
    + approve()
    + pickup()
    + deliver()
}

class "PricingTariff / IPricingStrategy" as Pricing <<strategy>> {
    - baseRate: double
    - kmRate: double
    + calculateQuote(...)
}

class "ITelemetrySource / Adapter" as Telemetry <<adapter>> {
    - locations: Map
    + recordMilestone()
    + getLatestCoordinates()
}

OrderProcessor -[hidden]r-> DispatchManager
DispatchManager -[hidden]r-> ShipmentTracker
ShipmentTracker -[hidden]r-> PaymentProcessor
PaymentProcessor -[hidden]r-> DataStore

Customer -[hidden]r-> Order
Order -[hidden]r-> ServiceOffering
ServiceOffering -[hidden]r-> Branch
Branch -[hidden]r-> Invoice

Consignment -[hidden]r-> Shipment
Shipment -[hidden]r-> Vehicle
Vehicle -[hidden]r-> Driver
Driver -[hidden]r-> Payment

Person -[hidden]r-> Receipt
Receipt -[hidden]r-> State
State -[hidden]r-> Pricing
Pricing -[hidden]r-> Telemetry

OrderProcessor --> "1" Customer
OrderProcessor --> "1" Order
DispatchManager --> "1" Shipment
ShipmentTracker --> "1" Shipment
PaymentProcessor --> "1" Payment

Customer "1" --> "1..*" Order
Order "1" --> "1..*" Consignment
Order "1" --> "1" ServiceOffering
Order "1" --> "0..1" Shipment
Branch "1" --> "1..*" Vehicle
Branch "1" --> "1..*" Driver
Shipment "1" --> "1" Vehicle
Shipment "1" --> "1" Driver
Invoice "1" --> "1..*" Payment
Payment "1" --> "1" Receipt

Order ..> State
Shipment ..> State
Invoice ..> State
Payment ..> State
ServiceOffering ..> Pricing
PaymentProcessor ..> Pricing
ShipmentTracker ..> Telemetry

OrderProcessor .[#D13212].> DataStore
DispatchManager .[#D13212].> DataStore
ShipmentTracker .[#D13212].> DataStore
PaymentProcessor .[#D13212].> DataStore

@enduml